// Cloudflare Workers configuration for the Anemos Interactive site.
//
// The pages in public/ are served as static assets (404.html for missing paths, clean URLs so
// /about.html is served at /about). The Worker in src/ adds the blog: /blogs and the posts
// under it, the RSS feed, the sitemap with posts included, images under /media/, and the
// blog admin on the admin.* hostname. Only the paths in run_worker_first reach the Worker;
// everything else is served straight from the assets.
//
//   npx wrangler deploy                    -> production worker "anemos-website", the live domain
//   npx wrangler deploy --env test         -> worker "anemos-website-test" at test.anemosinteractive.com
//
// Each environment has its own database and image bucket, so nothing written on test can
// appear on the live site. The admin sign-in (Cloudflare Access with the
// Microsoft 365 accounts) is configured per hostname with ACCESS_TEAM_DOMAIN and ACCESS_AUD;
// until those are set, the admin uses the DEV_KEY secret (npx wrangler secret put DEV_KEY --env …).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anemos-website",
  "main": "src/worker.js",
  "build": { "command": "node scripts/stamp.mjs" },
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/blogs", "/blogs/*", "/media/*", "/sitemap.xml", "/robots.txt", "/admin", "/admin/*", "/api/*",
      "/", "/index.html", "/products", "/products.html", "/about", "/about.html", "/book", "/book.html",
      "/contact", "/contact.html", "/privacy", "/privacy.html", "/terms", "/terms.html", "/404.html"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://anemosinteractive.com",
    "ADMIN_HOST": "admin.anemosinteractive.com",
    "ALLOWED_DOMAIN": "anemosinteractive.com",
    "ADMIN_EMAILS": "ronak.jacob@anemosinteractive.com",
    "AUTHOR_GROUP": "f360bb55-4a9b-4cfe-96ae-0967992164aa",
    "ACCESS_TEAM_DOMAIN": "anemosinteractive.cloudflareaccess.com",
    "ACCESS_AUD": "150303c95eb8cbc21a81afc79bdd01b9577bacd1e47f7bd9afccbcfe667d6771",
    "INDEXNOW_KEY": "a27d56b48e034ce6914a721e3666ef76"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "anemos-blog", "database_id": "c29317a9-b8ce-49c5-b3f8-7611315bb4ad" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "anemos-blog" }
  ],
  "routes": [
    { "pattern": "anemosinteractive.com", "custom_domain": true },
    { "pattern": "www.anemosinteractive.com", "custom_domain": true },
    { "pattern": "admin.anemosinteractive.com", "custom_domain": true }
  ],
  "env": {
    "test": {
      "name": "anemos-website-test",
      "vars": {
        "SITE_ORIGIN": "https://test.anemosinteractive.com",
        "ADMIN_HOST": "admin-test.anemosinteractive.com",
        "ALLOWED_DOMAIN": "anemosinteractive.com",
        "ADMIN_EMAILS": "ronak.jacob@anemosinteractive.com",
        "AUTHOR_GROUP": "f360bb55-4a9b-4cfe-96ae-0967992164aa",
        "ACCESS_TEAM_DOMAIN": "anemosinteractive.cloudflareaccess.com",
        "ACCESS_AUD": "af7cdb7b413d314095f86b30f70174eb1dc9f5552499cd4322112a226d319b66",
        "INDEXNOW_KEY": ""
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "anemos-blog-test", "database_id": "e0f5514e-b924-4c10-8912-c9bfff149bd0" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "anemos-blog-test" }
      ],
      "routes": [
        { "pattern": "test.anemosinteractive.com", "custom_domain": true },
        { "pattern": "admin-test.anemosinteractive.com", "custom_domain": true }
      ]
    }
  }
}
